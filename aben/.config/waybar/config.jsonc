{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    // Module Layout
    "modules-left": [
        "custom/lain-intro",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "clock",
        "tray"
    ],

    // Modules Configuration
    "custom/lain-intro": {
        "format": " [ PRESENT DAY, PRESENT TIME * HAHAHA... ] ",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "format": "{name}"
    },

    "mpris": {
        "format": "󱡬 {title}",
        "format-paused": "{status_icon} {title}",
        "max-length": 40,
        "player-icons": {
            "default": "⏸"
        },
        "status-icons": {
            "paused": "▶"
        }
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "clock": {
        // Completely removed the broken 'local' timezone string to solve the error
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": " {:%I:%M %p}", 
        "format-alt": " {:%Y-%m-%d}"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {used:0.1f}G" // Shows actual RAM usage in GBs instead of just percentage
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " Wired",
        "tooltip-format": " {ifname}",
        "format-disconnected": "⚠ Offline"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " Muted",
        "on-click": "pavucontrol",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        }
    }
}
